# VIDEOSEC Configuration
# Replace with your own email and credentials to receive real OTP emails

VIDEOSEC_JWT_SECRET=super-secret-videosec-jwt-token-key-2026
VIDEOSEC_JWT_EXPIRY_HOURS=12

# --- Email (SMTP) Configuration for Real OTP Delivery ---
# Example for Gmail:
# 1. Go to your Google Account > Security > 2-Step Verification > App passwords.
# 2. Generate a new App Password (select 'Mail').
# 3. Paste the 16-character password below:

VIDEOSEC_SMTP_HOST=smtp.gmail.com
VIDEOSEC_SMTP_PORT=587
VIDEOSEC_SMTP_USER=your_email@gmail.com
VIDEOSEC_SMTP_PASSWORD=xxxx xxxx xxxx xxxx
VIDEOSEC_SMTP_FROM=your_email@gmail.com
VIDEOSEC_SMTP_USE_TLS=true

# OTP Expiration in minutes (default: 10)
VIDEOSEC_OTP_EXPIRY_MINUTES=10
